{
  "name": "rpg-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @rpg-forge/web dev",
    "build": "pnpm --filter @rpg-forge/web build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @rpg-forge/db generate",
    "db:migrate": "pnpm --filter @rpg-forge/web db:migrate",
    "db:seed": "pnpm --filter @rpg-forge/web db:seed",
    "db:check": "pnpm --filter @rpg-forge/db check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
